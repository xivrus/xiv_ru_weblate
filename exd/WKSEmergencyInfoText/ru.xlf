      <trans-unit id="7" xml:space="preserve" approved="no">
        <source>7</source>
        <target state="translated">Атмосферное давление падает, предвещая закалочные ветры! Примите все необходимые меры, чтобы защитить себя от холода!</target>
      </trans-unit>
      <trans-unit id="8" xml:space="preserve" approved="no">
