      <trans-unit id="0" xml:space="preserve" approved="no">
        <source>0</source>
        <target state="translated">TEXT_KINGRA101_04960_SEQ_00&lt;tab&gt;Стильный незнакомец выглядит так, словно кого-то выискивает.</target>
      </trans-unit>
      <trans-unit id="1" xml:space="preserve" approved="no">
        <source>1</source>
      </trans-unit>
      <trans-unit id="2" xml:space="preserve" approved="no">
        <source>2</source>
      </trans-unit>
      <trans-unit id="3" xml:space="preserve" approved="no">
        <source>3</source>
      </trans-unit>
