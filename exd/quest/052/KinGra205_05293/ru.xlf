      <trans-unit id="0" xml:space="preserve" approved="no">
        <source>0</source>
        <target state="translated">TEXT_KINGRA205_05293_SEQ_00&lt;tab&gt;Ваша подруга явно беспокоится.</target>
      </trans-unit>
